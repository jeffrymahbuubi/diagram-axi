# build output and caches
dist/
.astro/

# dependencies (never commit; `npm ci` restores them from package-lock.json)
node_modules/

# generated by `npm run gen:pages` from the review artefacts named in kit.config.json (never edit)
src/content/docs/review/
src/generated/
public/review/
src/content/docs/bakeoff/
public/bakeoff/

# machine-local overrides (absolute paths to the main checkout's out/ and dist/)
kit.config.local.json

# browser QA artefacts
.playwright-cli/
.review-shots/

# logs and environment
npm-debug.log*
.env
.env.*
.DS_Store
