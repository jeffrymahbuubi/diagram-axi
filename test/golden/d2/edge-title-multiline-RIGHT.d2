direction: right
d2_title: "Line one\nLine two\nLine three" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}
a: "A" {
  shape: rectangle
  style.fill: "#a5d8ff"
  style.stroke: "#1e1e1e"
  style.font-color: "#1e1e1e"
}
b: "B" {
  shape: rectangle
  style.fill: "#a5d8ff"
  style.stroke: "#1e1e1e"
  style.font-color: "#1e1e1e"
}
a -> b: "go" {
  style.stroke: "#1e1e1e"
  style.font-size: 14
  style.font-color: "#1e1e1e"
}
