direction: down
d2_title: "Kubernetes deployment" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}
internet: "Internet" {
  shape: oval
  style.fill: "#a5d8ff"
  style.stroke: "#1e1e1e"
  style.font-color: "#1e1e1e"
}
cluster: "Cluster" {
  label.near: top-left
  style.font-size: 16
  style.fill: "#dbe4ff"
  style.stroke: "#868e96"
  style.font-color: "#1e1e1e"
  ingress: "Ingress" {
    shape: rectangle
    style.fill: "#a5d8ff"
    style.stroke: "#1e1e1e"
    style.font-color: "#1e1e1e"
  }
  ns: "Namespace:\nprod" {
    label.near: top-left
    style.font-size: 16
    style.fill: "#d3f9d8"
    style.stroke: "#868e96"
    style.font-color: "#1e1e1e"
    svc: "Service" {
      shape: rectangle
      style.fill: "#a5d8ff"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
    pod1: "Pod A" {
      shape: rectangle
      style.fill: "#a5d8ff"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
    pod2: "Pod B" {
      shape: rectangle
      style.fill: "#a5d8ff"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
    pod3: "Pod C" {
      shape: rectangle
      style.fill: "#a5d8ff"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
    cfg: "ConfigMap" {
      shape: rectangle
      style.fill: "#fff3bf"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
    pvc: "PersistentVolume" {
      shape: cylinder
      style.fill: "#c3fae8"
      style.stroke: "#1e1e1e"
      style.font-color: "#1e1e1e"
    }
  }
}
internet -> cluster.ingress: "443" {
  style.stroke: "#1e1e1e"
  style.font-size: 14
  style.font-color: "#1e1e1e"
}
cluster.ingress -> cluster.ns.svc: {
  style.stroke: "#1e1e1e"
}
cluster.ns.svc -> cluster.ns.pod1: {
  style.stroke: "#1e1e1e"
}
cluster.ns.svc -> cluster.ns.pod2: {
  style.stroke: "#1e1e1e"
}
cluster.ns.svc -> cluster.ns.pod3: {
  style.stroke: "#1e1e1e"
}
cluster.ns.cfg -> cluster.ns.pod1: {
  style.stroke: "#1e1e1e"
  style.stroke-dash: 2
}
cluster.ns.cfg -> cluster.ns.pod2: {
  style.stroke: "#1e1e1e"
  style.stroke-dash: 2
}
cluster.ns.cfg -> cluster.ns.pod3: {
  style.stroke: "#1e1e1e"
  style.stroke-dash: 2
}
cluster.ns.pod1 -> cluster.ns.pvc: "mount" {
  style.stroke: "#1e1e1e"
  style.font-size: 14
  style.font-color: "#1e1e1e"
}
